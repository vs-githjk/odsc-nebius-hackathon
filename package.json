{
  "name": "patient-zero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/pz/tsconfig.json",
    "test": "vitest run",
    "schema": "node --import tsx packages/pz/scripts/export-schema.ts",
    "fixtures": "node -e \"console.error('fixtures not built yet'); process.exit(1)\"",
    "pz": "node --env-file-if-exists=.env --import tsx packages/pz/src/cli/pz.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
